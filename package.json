{
  "name": "pharmacare",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @pharmacare/web",
    "build": "npm run build --workspace @pharmacare/web",
    "start": "npm run start --workspace @pharmacare/web",
    "lint": "npm run lint --workspace @pharmacare/web",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/database/prisma/schema.prisma",
    "db:seed": "prisma db seed --schema packages/database/prisma/schema.prisma",
    "db:studio": "prisma studio --schema packages/database/prisma/schema.prisma",
    "test": "tsx --test packages/shared/test/*.test.ts apps/web/test/*.test.ts",
    "test:db": "tsx --test packages/database/test/*.test.ts"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "zod": "^4.1.12"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.1"
  },
  "prisma": {
    "seed": "tsx packages/database/prisma/seed.ts"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
