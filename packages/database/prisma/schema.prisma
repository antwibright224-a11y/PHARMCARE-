generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  PHARMACY_MANAGER
  PHARMACIST
  CASHIER
  INVENTORY_MANAGER
}
enum PaymentMethod {
  CASH
  MOBILE_MONEY
  CARD
  BANK_TRANSFER
  SPLIT
}
enum PurchaseStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}
enum MovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  WRITE_OFF
}
enum ReturnDisposition {
  RESTOCK
  DAMAGED
  EXPIRED
}

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret String?
  role Role @default(CASHIER)
  requestedRole Role?
  disabled Boolean @default(false)
  createdAt DateTime @default(now())
  sales Sale[]
  auditLogs AuditLog[]
  sessions Session[]
  twoFactorChallenges TwoFactorChallenge[]
  stockMovements StockMovement[]
}

model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  mfaVerified Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([userId])
}

model TwoFactorChallenge {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  setupSecret String?
  emailCodeHash String?
  attempts Int @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}

model Permission {
  id String @id @default(cuid())
  role Role
  resource String
  action String
  allowed Boolean @default(false)
  @@unique([role, resource, action])
}

model PharmacySettings {
  id String @id @default("default")
  name String @default("PharmaCare Pharmacy")
  logoUrl String @default("")
  address String @default("")
  phone String @default("")
  email String @default("")
  receiptFooter String @default("Thank you for choosing us.")
  currency String @default("GHS")
  timezone String @default("Africa/Accra")
  taxRate Decimal @default(0) @db.Decimal(5, 2)
  expiryAlertDays Int @default(90)
  updatedAt DateTime @updatedAt
}

model Medicine {
  id String @id @default(cuid())
  name String
  genericName String @default("")
  sku String @unique
  barcode String? @unique
  category String
  dosageForm String
  strength String
  manufacturer String @default("")
  prescriptionRequired Boolean @default(false)
  sellingPrice Decimal @db.Decimal(12, 2)
  reorderLevel Int @default(10)
  archived Boolean @default(false)
  batches Batch[]
  saleItems SaleItem[]
  purchaseLines PurchaseLine[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([name, genericName])
}

model Supplier {
  id String @id @default(cuid())
  name String
  contactName String @default("")
  email String @default("")
  phone String @default("")
  address String @default("")
  purchases PurchaseOrder[]
  createdAt DateTime @default(now())
}

model Batch {
  id String @id @default(cuid())
  medicineId String
  medicine Medicine @relation(fields: [medicineId], references: [id])
  batchNumber String
  expiryDate DateTime
  purchaseCost Decimal @db.Decimal(12, 2)
  sellingPrice Decimal @db.Decimal(12, 2)
  quantity Int @default(0)
  receivedAt DateTime @default(now())
  movements StockMovement[]
  saleItems SaleItem[]
  @@unique([medicineId, batchNumber])
  @@index([medicineId, expiryDate])
}

model PurchaseOrder {
  id String @id @default(cuid())
  orderNumber String @unique
  supplierId String
  supplier Supplier @relation(fields: [supplierId], references: [id])
  status PurchaseStatus @default(DRAFT)
  total Decimal @default(0) @db.Decimal(12, 2)
  notes String @default("")
  idempotencyKey String? @unique
  lines PurchaseLine[]
  payments SupplierPayment[]
  receipts PurchaseReceipt[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseReceipt {
  id String @id @default(cuid())
  purchaseId String
  purchase PurchaseOrder @relation(fields: [purchaseId], references: [id])
  idempotencyKey String @unique
  createdAt DateTime @default(now())
}

model PurchaseLine {
  id String @id @default(cuid())
  purchaseId String
  purchase PurchaseOrder @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  medicineId String
  medicine Medicine @relation(fields: [medicineId], references: [id])
  quantity Int
  receivedQuantity Int @default(0)
  unitCost Decimal @db.Decimal(12, 2)
  @@index([purchaseId])
}

model Sale {
  id String @id @default(cuid())
  receiptNumber String @unique
  userId String
  user User @relation(fields: [userId], references: [id])
  subtotal Decimal @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  tax Decimal @default(0) @db.Decimal(12, 2)
  total Decimal @db.Decimal(12, 2)
  costOfGoods Decimal @db.Decimal(12, 2)
  idempotencyKey String @unique
  prescriptionReference String?
  items SaleItem[]
  payments Payment[]
  returns SaleReturn[]
  createdAt DateTime @default(now())
  @@index([createdAt])
}

model SaleItem {
  id String @id @default(cuid())
  saleId String
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  medicineId String
  medicine Medicine @relation(fields: [medicineId], references: [id])
  batchId String
  batch Batch @relation(fields: [batchId], references: [id])
  quantity Int
  unitPrice Decimal @db.Decimal(12, 2)
  unitCost Decimal @db.Decimal(12, 2)
  @@index([saleId])
}

model Payment {
  id String @id @default(cuid())
  saleId String
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method PaymentMethod
  amount Decimal @db.Decimal(12, 2)
  reference String @default("")
  createdAt DateTime @default(now())
}

model SaleReturn {
  id String @id @default(cuid())
  saleId String
  sale Sale @relation(fields: [saleId], references: [id])
  reason String
  refundAmount Decimal @db.Decimal(12, 2)
  idempotencyKey String @unique
  items ReturnItem[]
  createdAt DateTime @default(now())
}

model ReturnItem {
  id String @id @default(cuid())
  returnId String
  saleReturn SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItemId String
  quantity Int
  disposition ReturnDisposition
  @@index([saleItemId])
}

model StockMovement {
  id String @id @default(cuid())
  batchId String
  batch Batch @relation(fields: [batchId], references: [id])
  type MovementType
  quantity Int
  reason String @default("")
  reference String @default("")
  actorId String
  actor User @relation(fields: [actorId], references: [id])
  idempotencyKey String? @unique
  createdAt DateTime @default(now())
  @@index([createdAt])
}

model Expense {
  id String @id @default(cuid())
  category String
  amount Decimal @db.Decimal(12, 2)
  date DateTime @default(now())
  note String @default("")
  paymentMethod PaymentMethod
  idempotencyKey String @unique
  createdAt DateTime @default(now())
}

model SupplierPayment {
  id String @id @default(cuid())
  purchaseId String
  purchase PurchaseOrder @relation(fields: [purchaseId], references: [id])
  amount Decimal @db.Decimal(12, 2)
  method PaymentMethod
  reference String @default("")
  idempotencyKey String @unique
  createdAt DateTime @default(now())
}

model AuditLog {
  id String @id @default(cuid())
  actorId String
  actor User @relation(fields: [actorId], references: [id])
  action String
  entity String
  entityId String
  changes Json
  createdAt DateTime @default(now())
  @@index([entity, entityId])
  @@index([createdAt])
}

model Notification {
  id String @id @default(cuid())
  title String
  message String
  type String
  read Boolean @default(false)
  createdAt DateTime @default(now())
}
